<Window x:Class="MakingTop.PinnedPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="置顶管理面板"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="408"
        WindowStartupLocation="CenterScreen">

    <!-- 阴影留白区 -->
    <Grid Margin="24">
        <Border x:Name="WindowCard"
                CornerRadius="12"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270"
                                  Opacity="0.18" Color="#000000"/>
            </Border.Effect>

            <StackPanel Margin="20,16,20,18">

                <!-- 标题行（可拖动） -->
                <Grid MouseLeftButtonDown="OnTitleDrag">
                    <TextBlock Text="置顶窗口"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <Button Width="24" Height="24"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnCloseClick" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12" Background="#E9E9E7">
                                    <TextBlock Text="✕" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock x:Name="CountText"
                           Text="已置顶 0 / 0 个窗口"
                           FontSize="12" Margin="2,14,0,8"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <!-- 全部窗口列表卡片（行由代码动态生成，开关实时反映置顶状态） -->
                <Border Style="{StaticResource AppleCard}">
                    <Grid>
                        <!-- 空状态 -->
                        <StackPanel x:Name="EmptyState" Margin="0,18"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="未发现可管理的窗口"
                                       FontSize="13" Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="请确认桌面上有已打开的应用"
                                       FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- 动态行容器（外层滚动，超出限高） -->
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RowsPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 底部按钮 -->
                <Grid Margin="2,16,2,0">
                    <Button x:Name="UnpinAllButton" Content="全部取消"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PillButton}"
                            Click="OnUnpinAllClick"/>
                    <Button Content="完成"
                            HorizontalAlignment="Right"
                            Style="{StaticResource PillButtonPrimary}"
                            Click="OnCloseClick"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
