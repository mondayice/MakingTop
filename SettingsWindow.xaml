<Window x:Class="MakingTop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MakingTop"
        Title="设置"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="568"
        WindowStartupLocation="CenterScreen">

    <!-- 阴影留白区 -->
    <Grid Margin="24">
        <Border x:Name="WindowCard"
                CornerRadius="12"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270"
                                  Opacity="0.18" Color="#000000"/>
            </Border.Effect>

            <StackPanel Margin="20,16,20,18">

                <!-- 标题行（可拖动窗口） -->
                <Grid MouseLeftButtonDown="OnTitleDrag">
                    <TextBlock Text="设置"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <!-- 圆形关闭按钮 -->
                    <Button x:Name="CloseButton" Width="24" Height="24"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnCloseClick" Cursor="Hand" Focusable="False">
                        <Button.Background>
                            <SolidColorBrush Color="#E9E9E7"/>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12"
                                        Background="{TemplateBinding Background}">
                                    <TextBlock Text="✕" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock Text="全局快捷键（修改后立即生效）"
                           FontSize="12" Margin="2,14,0,8"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <!-- 快捷键卡片 -->
                <Border Style="{StaticResource AppleCard}">
                    <StackPanel>

                        <!-- 行 1：开始选择置顶窗口 -->
                        <Grid Height="58" Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="开始选择置顶窗口"
                                       FontSize="13" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <local:HotkeyBox x:Name="SelectBox" Style="{StaticResource HotkeyBoxStyle}"/>
                                <TextBlock x:Name="SelectStatus" FontSize="11" Margin="2,3,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" Text="未绑定"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="14,0"/>

                        <!-- 行 2：取消当前窗口置顶 -->
                        <Grid Height="58" Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="取消当前窗口置顶"
                                       FontSize="13" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <local:HotkeyBox x:Name="UnpinCurrentBox" Style="{StaticResource HotkeyBoxStyle}"/>
                                <TextBlock x:Name="UnpinCurrentStatus" FontSize="11" Margin="2,3,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" Text="未绑定"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="14,0"/>

                        <!-- 行 3：取消所有窗口置顶 -->
                        <Grid Height="58" Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="取消所有窗口置顶"
                                       FontSize="13" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <local:HotkeyBox x:Name="UnpinAllBox" Style="{StaticResource HotkeyBoxStyle}"/>
                                <TextBlock x:Name="UnpinAllStatus" FontSize="11" Margin="2,3,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" Text="未绑定"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="14,0"/>

                        <!-- 行 4：置顶管理面板 -->
                        <Grid Height="58" Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="置顶管理面板"
                                           FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="查看并切换所有置顶状态"/>
                                    <Hyperlink x:Name="OpenPanelLink" Foreground="{StaticResource AccentBrush}"
                                               TextDecorations="None" Click="OnOpenPanelClick">
                                        <Run Text="立即打开"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <local:HotkeyBox x:Name="ShowPanelBox" Style="{StaticResource HotkeyBoxStyle}"/>
                                <TextBlock x:Name="ShowPanelStatus" FontSize="11" Margin="2,3,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" Text="未绑定"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- 底部按钮 -->
                <Grid Margin="2,16,2,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="RestoreDefaultButton" Content="恢复默认"
                                Style="{StaticResource PillButton}"
                                Click="OnRestoreDefaultClick"/>
                        <Button x:Name="ResetButton" Content="全部清除"
                                Margin="8,0,0,0"
                                Style="{StaticResource PillButton}"
                                Click="OnResetClick"/>
                    </StackPanel>
                    <Button x:Name="DoneButton" Content="完成"
                            HorizontalAlignment="Right"
                            Style="{StaticResource PillButtonPrimary}"
                            Click="OnCloseClick"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
