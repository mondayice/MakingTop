<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Notion 暖橙配色
      背景 #F7F6F3 · 正文 #37352F · 辅助 #9B9A97 · 分割线 #E9E9E7
      主橙   #E16259 · 浅橙底 #FDEDEC · hover 加深 #FAD2CF
    -->
    <Color x:Key="BgColor">#F7F6F3</Color>
    <Color x:Key="TextColor">#37352F</Color>
    <Color x:Key="TextMutedColor">#9B9A97</Color>
    <Color x:Key="DividerColor">#E9E9E7</Color>
    <Color x:Key="AccentColor">#E16259</Color>
    <Color x:Key="AccentSoftColor">#FDEDEC</Color>
    <Color x:Key="AccentHoverColor">#FAD2CF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>

    <!-- 图钉图标几何（Material push_pin，24×24 设计坐标），托盘/悬浮图标/光标共用 -->
    <Geometry x:Key="PinGeometry">M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z</Geometry>

    <!--
      托盘右键菜单：无边框简约样式
      浅灰底 #F7F6F3、圆角 8、淡分割线 #E9E9E7、柔和投影
    -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <!-- Margin=8 给柔和投影留出透明边距 -->
                    <Border Margin="8"
                            Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                              Opacity="0.14" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      菜单项：hover 时浅橙底 #FDEDEC + 文字变主橙 #E16259（菜单类交互瞬时变色，不做动画）
      支持两种形态：
        叶子项（TopLevelItem/SubmenuItem）—— 点击执行
        带子菜单项（TopLevelHeader/SubmenuHeader）—— hover 自动展开子列表（右侧箭头指示）
    -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Padding="10,7"
                                Background="{TemplateBinding Background}">
                            <DockPanel LastChildFill="True">
                                <!-- 子菜单箭头（仅带子项时显示） -->
                                <Path x:Name="Arrow"
                                      DockPanel.Dock="Right"
                                      Data="M0,0 L4,4 L0,8 Z"
                                      Fill="{StaticResource TextMutedBrush}"
                                      VerticalAlignment="Center"
                                      Margin="10,1,0,0"
                                      Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </DockPanel>
                        </Border>

                        <!-- 子菜单弹出层：与主菜单同款浅灰圆角 + 柔和投影 -->
                        <Popup x:Name="PART_Popup"
                               Placement="Right"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None"
                               IsOpen="{TemplateBinding IsSubmenuOpen}">
                            <Border Margin="8"
                                    Background="{StaticResource BgBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                                      Opacity="0.14" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 带子项的菜单项：显示展开箭头 -->
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单分割线：浅灰 #E9E9E7 -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Margin="6,4" Background="{StaticResource DividerBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
